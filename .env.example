# Variables d'environnement — Référence Informatique V2
# Copier ce fichier en .env pour le développement local (jamais commité —
# voir .gitignore). Chaque variable indique l'étape du playbook où elle
# devient nécessaire.

# --- Étape 2 : Supabase (base de données, auth, storage) ---
# Trouvables dans Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète — jamais préfixée NEXT_PUBLIC_, jamais envoyée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Étape 2 : Prisma (connexion à la base Supabase) ---
# Les deux valeurs sont données ensemble dans Supabase > Connect > ORM >
# Prisma, mais ont chacune un seul usage (Prisma 7 n'a plus de champ
# `directUrl` : voir prisma.config.ts et prisma/schema.prisma) :
#   - DATABASE_URL : pooler en mode transaction (port 6543) — utilisée à
#     l'exécution par l'application, via l'adaptateur dans
#     lib/prisma/client.ts.
#   - DIRECT_URL   : pooler en mode session (port 5432) — utilisée par la
#     CLI Prisma (prisma.config.ts), en particulier `prisma migrate`.
DATABASE_URL=
DIRECT_URL=

# --- Étape 2 : seed de développement (compte admin de test) ---
# Optionnel — si absent, le script de seed ignore simplement la création du
# compte admin. Ne jamais utiliser ces identifiants en production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Étape 10 : SasPay (paiement carte + mobile money) ---
# Dashboard : https://app.saspay.me — Docs : https://docs.saspay.me
# Une seule URL d'API : c'est le préfixe de la clé qui choisit l'environnement
# (sk_test_... = tests, sk_live_... = production). Démarrer avec une clé test ;
# la clé live n'est délivrée qu'après validation KYC du compte marchand.
# La clé doit avoir la portée PAYIN (ou BOTH).
SASPAY_SECRET_KEY=
# Secret de signature du webhook, affiché à la création du webhook dans le
# dashboard SasPay. URL à déclarer : https://<votre-domaine>/api/webhooks/saspay
# Événement utile : transaction.success
SASPAY_WEBHOOK_SECRET=

# --- Étape 12 : Brevo (emails transactionnels) ---
# Nécessite le domaine reference-informatique.com vérifié en SPF/DKIM.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@reference-informatique.com
# Adresse qui reçoit les notifications internes (nouvelle commande, devis).
ADMIN_NOTIFICATION_EMAIL=nosservicesinformatiques@gmail.com

# --- Général ---
# URL publique du site, utilisée pour générer les liens absolus (emails, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Étape 11 : WhatsApp Business (numéro de commande) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=22675789737

# --- Accès par pays (clés de formations réservées au Burkina Faso) ---
# Le pays du visiteur vient de l'en-tête x-vercel-ip-country, posé par Vercel.
# En local il n'y a pas d'en-tête : le site simule le Burkina Faso. Pour tester
# la vue d'un visiteur étranger, décommentez la ligne ci-dessous (ex. FR).
# DEV_VISITOR_COUNTRY=FR
